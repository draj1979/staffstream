# Installed automatically by scripts/db-vm-startup.sh (GCE startup-script,
# runs on every boot) — kept here as a standalone, reviewable copy rather
# than only existing inside a bash heredoc. If you ever need to
# reinstall/repair it by hand:
#   sudo cp systemd/staffstream-db.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now staffstream-db.service
[Unit]
Description=StaffStream demo — db-vm (Postgres + Redis)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/staffstream
ExecStart=/usr/bin/docker compose -f db-compose.yml up -d
ExecStop=/usr/bin/docker compose -f db-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

# backend-vm — copy to .env next to backend-compose.yml on backend-vm
# (gitignored; never commit the real file). This is a DEMO deployment: a
# plaintext .env file on disk is an accepted shortcut here, not a pattern
# to carry into production — see infra/terraform/gcp/README.md's Secret
# Manager + Workload Identity setup for how the real deployment path
# handles secrets instead (no plaintext files, no long-lived credentials
# at all, no shared JWT signing key sitting in a file on a VM).

# --- Artifact Registry image source ----------------------------------------
# Same repo the GKE deployment path pushes to — see
# ../terraform/gcp/artifact_registry.tf and
# ../../.github/workflows/deploy-gcp.yml.
AR_HOST=asia-south1-docker.pkg.dev
GCP_PROJECT_ID=your-gcp-project-id
IMAGE_TAG=latest

# --- Networking --------------------------------------------------------
# db-vm's internal IP (from `gcloud compute instances describe db-vm
# --format='get(networkInterfaces[0].networkIP)'`, or setup.sh prints it
# after creating db-vm). Every DB-backed service's DATABASE_URL and
# api-gateway's REDIS_URL are built from this — never localhost, never a
# container name, since db-vm is a separate machine.
DB_VM_INTERNAL_IP=10.128.0.2

# The domain Caddy requests a TLS cert for — must already have an A
# record pointing at backend-vm's static external IP (see setup.sh)
# before starting the stack, or the ACME HTTP-01 challenge fails.
DEMO_DOMAIN=demo.example.com

# --- Shared across every service --------------------------------------
# Must be IDENTICAL to whatever every service uses to mint/verify JWTs —
# there's only one value here because there's only one process boundary
# (backend-vm), unlike the GKE path where this lives in Secret Manager
# per-service. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=REPLACE_ME_with_a_long_random_value

# --- Postgres (must match db-vm's .env exactly) -------------------------
POSTGRES_USER=staffstream
POSTGRES_PASSWORD=REPLACE_ME_with_the_same_password_as_db-vm

# --- LLM Gateway ---------------------------------------------------------
# Only needed to actually call that provider — the service starts fine
# without them, calls just fail with a normal auth error from the
# provider until set (same as every other deployment path).
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-openai-key-here
GEMINI_API_KEY=your-gemini-key-here
MISTRAL_API_KEY=your-mistral-key-here
DEEPSEEK_API_KEY=your-deepseek-key-here
LLAMA_API_KEY=your-groq-key-here
DEFAULT_PROVIDER=claude

# --- Knowledge Service -----------------------------------------------------
VOYAGE_API_KEY=pa-your-voyage-key-here

# --- Auth Service SSO (optional — only if you configure SSO for a tenant) ---
# Fernet key encrypting each tenant's SSO client secret at rest; has a
# working local/demo default in backend-compose.yml if you leave this
# unset, but every real deployment should generate its own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSO_ENCRYPTION_KEY=gglttmY9baFzyNjGySfCNv-Xg_r-vaxIePrRyNv-s9Q=

# --- Not included in this demo (see backend-compose.yml's top comment) ---
# Skill Marketplace's OAuth client credentials (SLACK_CLIENT_ID, etc.) and
# Audit Service's/RabbitMQ's env vars don't apply here — those two
# services aren't part of this deployment.

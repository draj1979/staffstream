# db-vm — copy to .env next to db-compose.yml on db-vm (gitignored; never
# commit the real file). This is a DEMO deployment: a plaintext .env file
# on disk is an accepted shortcut here, not a pattern to carry into
# production — see infra/terraform/gcp/README.md's Secret Manager +
# Workload Identity setup for how the real deployment path handles
# secrets instead (no plaintext files, no long-lived credentials at all).

# Any real password — this is the only credential Postgres itself needs;
# every service's own DATABASE_URL in backend.env.example embeds this
# same value.
POSTGRES_USER=staffstream
POSTGRES_PASSWORD=REPLACE_ME_with_a_real_password

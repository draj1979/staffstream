__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
!.env.example
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/
.coverage
htmlcov/
.DS_Store
node_modules/
infra/k8s/secret.yaml

# Terraform — state and plan files can contain resource attributes that
# are effectively secret (e.g. generated DB passwords in secrets.tf's
# outputs), and .tfvars is where a real project_id/environment lives, not
# something to commit. .terraform.lock.hcl is deliberately NOT ignored
# (like uv.lock, it's meant to be committed) — nor is
# terraform.tfvars.example, which is the template, no real values.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan*
*.tfvars
!terraform.tfvars.example

# infra/gcp-vm-demo — db.env/backend.env are real secrets (JWT signing
# key, DB password, LLM API keys) on the same footing as the root .env
# above, just named to match each VM's own copy rather than the repo's
# single .env convention — the *.env.example patterns above don't match
# this naming, so these need their own entries.
infra/gcp-vm-demo/db.env
infra/gcp-vm-demo/backend.env

# Personal Claude Code overrides for this project, not team-wide config.
.claude/settings.local.json

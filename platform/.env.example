# Shared across every service that mints or verifies JWTs — MUST be
# identical everywhere. Local-dev default lives in libs/auth/src/auth/config.py;
# real deployments set this from Vault / Secret Manager, never from a
# committed file.
JWT_SECRET_KEY=dev-only-insecure-shared-secret-do-not-use-in-production

# Tenant Service
TENANT_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/tenant_service

# Employee Service
EMPLOYEE_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/employee_service
EMPLOYEE_SERVICE_AGENT_REGISTRY_URL=http://localhost:8004
# Phase 10 — read at employee-creation time for the tenant's default
# LLM provider/model (Tenant.llm_config); falls back to Agent Registry's
# own hardcoded default if unreachable, so this is never a hard dependency.
EMPLOYEE_SERVICE_TENANT_SERVICE_URL=http://localhost:8001

# Auth Service
AUTH_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/auth_service
AUTH_SERVICE_EMPLOYEE_SERVICE_URL=http://localhost:8002
# Must match this service's externally reachable origin exactly — it's
# used to build the SSO redirect_uri registered with each tenant's IdP.
AUTH_SERVICE_PUBLIC_BASE_URL=http://localhost:8003
# Fernet key encrypting each tenant's SSO client_secret at rest — generate
# a real one with the same one-liner as OAUTH_ENCRYPTION_KEY below.
# Deliberately unprefixed so it's easy to source from a secret manager by
# a name that doesn't change if this service is ever renamed.
SSO_ENCRYPTION_KEY=gglttmY9baFzyNjGySfCNv-Xg_r-vaxIePrRyNv-s9Q=

# Agent Registry
AGENT_REGISTRY_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/agent_registry

# LLM Gateway — deliberately unprefixed: ANTHROPIC_API_KEY is the standard
# env var name the Anthropic SDK itself looks for.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Phase 10 — five more providers, all sharing one OpenAI-compatible-wire-
# format client except Claude (see services/llm-gateway/src/llm_gateway/
# providers/openai_compatible.py). Each api_key name matches what that
# provider's own SDK/tooling conventionally looks for; base_urls below are
# the defaults and only need overriding for a self-hosted/alternate vendor.
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=your-gemini-key-here
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MISTRAL_API_KEY=your-mistral-key-here
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
DEEPSEEK_API_KEY=your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Llama has no single canonical hosted API — defaults to Groq's
# OpenAI-compatible endpoint; point this at a different Llama host instead
# if that's what the tenant's deployment uses.
LLAMA_API_KEY=your-groq-key-here
# LLAMA_BASE_URL=https://api.groq.com/openai/v1

# Memory Service
MEMORY_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/memory_service

# Knowledge Service — its own dedicated Postgres+pgvector instance (see
# docker-compose.yml's postgres-vector service), not the shared one above.
KNOWLEDGE_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5434/knowledge_service
# Deliberately unprefixed: VOYAGE_API_KEY is the standard env var name the
# Voyage AI SDK itself looks for.
VOYAGE_API_KEY=pa-your-voyage-key-here

# OpenClaw Runtime — no database of its own; it's stateless.
OPENCLAW_RUNTIME_AGENT_REGISTRY_URL=http://localhost:8004
OPENCLAW_RUNTIME_LLM_GATEWAY_URL=http://localhost:8005
OPENCLAW_RUNTIME_MEMORY_SERVICE_URL=http://localhost:8007
OPENCLAW_RUNTIME_EMPLOYEE_SERVICE_URL=http://localhost:8002
OPENCLAW_RUNTIME_KNOWLEDGE_SERVICE_URL=http://localhost:8008
OPENCLAW_RUNTIME_SKILL_MARKETPLACE_URL=http://localhost:8010

# Skill Marketplace — skill registry, per-tenant enablement, per-employee
# OAuth connections (Slack, Google Calendar).
SKILL_MARKETPLACE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/skill_marketplace
# Fernet key encrypting OAuth tokens at rest — generate a real one with
# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
# Deliberately unprefixed so it's easy to source from a secret manager by
# a name that doesn't change if this service is ever renamed.
OAUTH_ENCRYPTION_KEY=lhp4HtY3bSUeh04zFJhS63DBmXPeAgB-TKRD2pOeWoc=
# Must match this service's externally reachable origin exactly — it's
# used to build each connector's OAuth redirect_uri.
SKILL_MARKETPLACE_PUBLIC_BASE_URL=http://localhost:8010
# Slack app (https://api.slack.com/apps) — OAuth & Permissions redirect
# URL must be set to {SKILL_MARKETPLACE_PUBLIC_BASE_URL}/connections/slack/callback
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
# Google Cloud OAuth client (console.cloud.google.com) — authorized
# redirect URI must be set to {SKILL_MARKETPLACE_PUBLIC_BASE_URL}/connections/google_calendar/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Phase 10 connectors — same per-employee OAuth pattern as Slack/Google
# Calendar above, redirect URI is always
# {SKILL_MARKETPLACE_PUBLIC_BASE_URL}/connections/{skill_id}/callback.
# Salesforce, Jira, Microsoft Teams/365, ServiceNow, SAP, and Oracle also
# need per-tenant instance details — those live in each tenant's
# TenantSkillEnablement.config (set via PUT /skills/{skill_id}/enablement),
# not here, since they differ per organization rather than per deployment.
SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret
HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret
JIRA_CLIENT_ID=your-atlassian-oauth-client-id
JIRA_CLIENT_SECRET=your-atlassian-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
# Shared by both Microsoft Teams and Microsoft 365 — same Entra ID app
# registration, same Graph API (see connectors/_microsoft.py).
MICROSOFT_CLIENT_ID=your-entra-id-app-client-id
MICROSOFT_CLIENT_SECRET=your-entra-id-app-client-secret
SERVICENOW_CLIENT_ID=your-servicenow-oauth-client-id
SERVICENOW_CLIENT_SECRET=your-servicenow-oauth-client-secret
SAP_CLIENT_ID=your-sap-btp-oauth-client-id
SAP_CLIENT_SECRET=your-sap-btp-oauth-client-secret
ORACLE_CLIENT_ID=your-oracle-idcs-client-id
ORACLE_CLIENT_SECRET=your-oracle-idcs-client-secret
# Meta app (developers.facebook.com) with WhatsApp Business added.
WHATSAPP_CLIENT_ID=your-meta-app-id
WHATSAPP_CLIENT_SECRET=your-meta-app-secret

# API Gateway — no database; Redis-backed per-tenant rate limiting.
API_GATEWAY_TENANT_SERVICE_URL=http://localhost:8001
API_GATEWAY_EMPLOYEE_SERVICE_URL=http://localhost:8002
API_GATEWAY_AUTH_SERVICE_URL=http://localhost:8003
API_GATEWAY_AGENT_REGISTRY_URL=http://localhost:8004
API_GATEWAY_LLM_GATEWAY_URL=http://localhost:8005
API_GATEWAY_OPENCLAW_RUNTIME_URL=http://localhost:8006
API_GATEWAY_MEMORY_SERVICE_URL=http://localhost:8007
API_GATEWAY_KNOWLEDGE_SERVICE_URL=http://localhost:8008
API_GATEWAY_SKILL_MARKETPLACE_URL=http://localhost:8010
# Defaults: 120 requests per tenant per 60s window; 2MB body limit (25MB
# for the knowledge-service upload path). Override only if you need to.
# API_GATEWAY_RATE_LIMIT_MAX_REQUESTS=120
# API_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
# API_GATEWAY_MAX_BODY_BYTES=2097152
# API_GATEWAY_MAX_UPLOAD_BODY_BYTES=26214400

REDIS_URL=redis://localhost:6379/0

# Event bus (phase 7) — deliberately unprefixed: LLM Gateway, OpenClaw
# Runtime, and Analytics Service all read this same var name.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Analytics Service — usage/tokens/cost/health, Admin/Finance/IT dashboards.
ANALYTICS_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/analytics_service

# Audit Service — immutable, tenant-scoped log of every state-changing
# action (employee CRUD, role changes, skill enablement, OAuth connect/
# revoke, tenant settings changes). Not routed through the API Gateway,
# same as Analytics Service — an internal/admin-facing read API.
AUDIT_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/audit_service

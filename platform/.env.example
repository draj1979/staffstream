# Shared across every service that mints or verifies JWTs — MUST be
# identical everywhere. Local-dev default lives in libs/auth/src/auth/config.py;
# real deployments set this from Vault / Secret Manager, never from a
# committed file.
JWT_SECRET_KEY=dev-only-insecure-shared-secret-do-not-use-in-production

# Tenant Service
TENANT_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/tenant_service

# Employee Service
EMPLOYEE_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/employee_service
EMPLOYEE_SERVICE_AGENT_REGISTRY_URL=http://localhost:8004

# Auth Service
AUTH_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/auth_service
AUTH_SERVICE_EMPLOYEE_SERVICE_URL=http://localhost:8002

# Agent Registry
AGENT_REGISTRY_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/agent_registry

# LLM Gateway — deliberately unprefixed: ANTHROPIC_API_KEY is the standard
# env var name the Anthropic SDK itself looks for.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Memory Service
MEMORY_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/memory_service

# Knowledge Service — its own dedicated Postgres+pgvector instance (see
# docker-compose.yml's postgres-vector service), not the shared one above.
KNOWLEDGE_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5434/knowledge_service
# Deliberately unprefixed: VOYAGE_API_KEY is the standard env var name the
# Voyage AI SDK itself looks for.
VOYAGE_API_KEY=pa-your-voyage-key-here

# OpenClaw Runtime — no database of its own; it's stateless.
OPENCLAW_RUNTIME_AGENT_REGISTRY_URL=http://localhost:8004
OPENCLAW_RUNTIME_LLM_GATEWAY_URL=http://localhost:8005
OPENCLAW_RUNTIME_MEMORY_SERVICE_URL=http://localhost:8007
OPENCLAW_RUNTIME_EMPLOYEE_SERVICE_URL=http://localhost:8002
OPENCLAW_RUNTIME_KNOWLEDGE_SERVICE_URL=http://localhost:8008

# API Gateway — no database; Redis-backed per-tenant rate limiting.
API_GATEWAY_TENANT_SERVICE_URL=http://localhost:8001
API_GATEWAY_EMPLOYEE_SERVICE_URL=http://localhost:8002
API_GATEWAY_AUTH_SERVICE_URL=http://localhost:8003
API_GATEWAY_AGENT_REGISTRY_URL=http://localhost:8004
API_GATEWAY_LLM_GATEWAY_URL=http://localhost:8005
API_GATEWAY_OPENCLAW_RUNTIME_URL=http://localhost:8006
API_GATEWAY_MEMORY_SERVICE_URL=http://localhost:8007
API_GATEWAY_KNOWLEDGE_SERVICE_URL=http://localhost:8008
# Defaults: 120 requests per tenant per 60s window; 2MB body limit (25MB
# for the knowledge-service upload path). Override only if you need to.
# API_GATEWAY_RATE_LIMIT_MAX_REQUESTS=120
# API_GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
# API_GATEWAY_MAX_BODY_BYTES=2097152
# API_GATEWAY_MAX_UPLOAD_BODY_BYTES=26214400

REDIS_URL=redis://localhost:6379/0

# Event bus (phase 7) — deliberately unprefixed: LLM Gateway, OpenClaw
# Runtime, and Analytics Service all read this same var name.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Analytics Service — usage/tokens/cost/health, Admin/Finance/IT dashboards.
ANALYTICS_SERVICE_DATABASE_URL=postgresql+asyncpg://staffstream:staffstream@localhost:5433/analytics_service

# Next.js only loads .env files from this directory — copy the values you
# need from the workspace-root .env.example, they aren't inherited.

DATABASE_URL=postgresql://user:pass@host/staffstream

AUTH0_SECRET=                     # random 32-char string: openssl rand -hex 32
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# M2M (client_credentials, for server-to-server calls)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=
